# Скопируйте в .env и задайте свои значения. Файл .env в Git НЕ попадает.
# Пароль можно сгенерировать: openssl rand -base64 24
DB_PASSWORD=change-me

# Для слоя TLS нужен отдельный локальный tls/private/district.key.
DISTRICT_HOST=gateway.city.lab

# Для compose.labs.yaml сгенерируйте отдельные значения. Например: openssl rand -hex 32
BUS_SECRET=
BUS_CONSUME_SECRET=
PRIVACY_SALT=
GATEWAY_ADMIN_TOKEN=
