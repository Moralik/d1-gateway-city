:80 {
	redir https://{host}:8443{uri} permanent
}

*.city.lab:8443 {
	tls /tls/district.crt /tls/private/district.key
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@passport host passport.city.lab
	reverse_proxy @passport https://10.0.0.2:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name passport.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@cityhall host cityhall.city.lab
	reverse_proxy @cityhall https://10.0.0.3:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name cityhall.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@bank host bank.city.lab
	reverse_proxy @bank https://10.0.0.10:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name bank.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@hospital host hospital.city.lab
	reverse_proxy @hospital https://10.0.0.20:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name hospital.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@grid host grid.city.lab
	reverse_proxy @grid https://10.0.0.30:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name grid.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@transport host transport.city.lab
	reverse_proxy @transport https://10.0.0.40:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name transport.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	@soc host soc.city.lab
	reverse_proxy @soc https://10.0.0.50:8443 {
		header_up Host {http.request.host}
		transport http {
			tls
			tls_server_name soc.city.lab
			tls_trusted_ca_certs /tls/city-root.crt
		}
	}

	handle {
		reverse_proxy http://api:8080
	}
}
